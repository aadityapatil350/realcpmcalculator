---
export interface Props {
  current: string;
}
const { current } = Astro.props;

const tools = [
  { href: '/', label: 'CPM Calculator', description: 'Cost per thousand impressions' },
  { href: '/cpc-calculator', label: 'CPC Calculator', description: 'Cost per click' },
  { href: '/ctr-calculator', label: 'CTR Calculator', description: 'Click-through rate' },
  { href: '/roas-calculator', label: 'ROAS Calculator', description: 'Return on ad spend' },
  { href: '/cac-calculator', label: 'CAC Calculator', description: 'Customer acquisition cost' },
  { href: '/cpv-calculator', label: 'CPV Calculator', description: 'Cost per view' },
];

const related = tools.filter(t => t.href !== current);
---
<section class="mt-12 pt-8 border-t border-[var(--color-border)]">
  <h2 class="text-xl font-semibold text-[var(--color-text)] mb-4">Related Calculators</h2>
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
    {related.map(tool => (
      <a
        href={tool.href}
        class="block rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-4 hover:border-[var(--color-accent)] transition-colors no-underline"
      >
        <div class="font-medium text-[var(--color-accent)]">{tool.label}</div>
        <div class="text-sm text-[var(--color-text-muted)] mt-0.5">{tool.description}</div>
      </a>
    ))}
  </div>
</section>
