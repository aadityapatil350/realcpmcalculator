---
import ThemeToggle from './ThemeToggle.astro';

export interface Props {
  current?: string;
}
const { current = '' } = Astro.props;

const navLinks = [
  { href: '/', label: 'CPM' },
  { href: '/cpc-calculator', label: 'CPC' },
  { href: '/ctr-calculator', label: 'CTR' },
  { href: '/roas-calculator', label: 'ROAS' },
  { href: '/cac-calculator', label: 'CAC' },
  { href: '/cpv-calculator', label: 'CPV' },
];
---
<header class="border-b border-[var(--color-border)] bg-[var(--color-bg)]">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 flex items-center justify-between h-14 gap-4">
    <a
      href="/"
      class="font-semibold text-[var(--color-text)] no-underline text-sm shrink-0"
      aria-label="Real CPM Calculator home"
    >
      RealCPMCalculator
    </a>
    <nav aria-label="Calculator tools" class="flex-1 overflow-x-auto">
      <ul class="flex items-center gap-1 list-none p-0 m-0">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              aria-current={link.href === current ? 'page' : undefined}
              class={`inline-block px-3 py-1.5 rounded-md text-sm no-underline whitespace-nowrap transition-colors min-h-[44px] flex items-center ${
                link.href === current
                  ? 'bg-[var(--color-accent)] text-white font-medium'
                  : 'text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:bg-[var(--color-bg-subtle)]'
              }`}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>
