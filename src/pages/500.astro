---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<BaseLayout
  title="Server Error – RealCPMCalculator.com"
  description="Something went wrong on our end. Please try again or return to the homepage."
  canonical="https://realcpmcalculator.com/500"
>
  <SiteHeader />
  <main class="max-w-3xl mx-auto px-4 sm:px-6 py-20 text-center">
    <p class="text-7xl font-bold text-[var(--color-accent)] mb-4">500</p>
    <h1 class="text-2xl font-semibold text-[var(--color-text)] mb-3">Something went wrong</h1>
    <p class="text-[var(--color-text-muted)] mb-8">
      There was a server error. This has been noted — please try again in a moment.
    </p>
    <a href="/" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-md bg-[var(--color-accent)] text-white text-sm font-medium hover:opacity-90 transition-opacity no-underline">
      Back to homepage
    </a>
  </main>
  <SiteFooter />
</BaseLayout>
