---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const pageUrl = 'https://realcpmcalculator.com/privacy';
const updated = 'August 29, 2026';
---
<BaseLayout
  title="Privacy Policy – RealCPMCalculator.com"
  description="Privacy policy for RealCPMCalculator.com. All calculations run in your browser — no input data is ever transmitted or stored."
  canonical={pageUrl}
>
  <SiteHeader />
  <main class="max-w-3xl mx-auto px-4 sm:px-6 py-10">
    <h1 class="text-3xl font-bold text-[var(--color-text)] mb-2">Privacy Policy</h1>
    <p class="text-sm text-[var(--color-text-muted)] mb-8">Last updated: {updated}</p>

    <div class="space-y-8 text-[var(--color-text-muted)] leading-relaxed">

      <section>
        <h2 class="text-xl font-semibold text-[var(--color-text)] mb-3">Data We Do Not Collect</h2>
        <p>
          All calculations on RealCPMCalculator.com run entirely in your browser using JavaScript. <strong class="text-[var(--color-text)]">No numbers, inputs, or calculation results are ever sent to our servers, stored in a database, or shared with any third party.</strong> When you close the browser tab, your calculation is gone. We have no way to retrieve it because we never received it.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-[var(--color-text)] mb-3">Cookies and Local Storage</h2>
        <p>
          We store one item in your browser's <code>localStorage</code>: your <strong>theme preference</strong> (light or dark mode). This value never leaves your device. We do not use cookies for tracking, analytics sessions, or user identification.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-[var(--color-text)] mb-3">Google AdSense</h2>
        <p>
          This site displays advertisements served by Google AdSense. Google uses cookies, including the DoubleClick cookie (DART cookie), to serve ads based on your prior visits to this and other websites. You may opt out of the use of the DART cookie by visiting the <a href="https://www.google.com/settings/ads" class="text-[var(--color-accent)]" rel="noopener noreferrer" target="_blank">Google Ad Settings page</a>.
        </p>
        <p class="mt-3">
          Third-party vendors, including Google, use cookies to serve ads based on a user's prior visits to this website or other websites. Google's use of advertising cookies enables it and its partners to serve ads based on your visit to this site and/or other sites on the Internet. For more information about Google's privacy practices, see the <a href="https://policies.google.com/privacy" class="text-[var(--color-accent)]" rel="noopener noreferrer" target="_blank">Google Privacy Policy</a>.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-[var(--color-text)] mb-3">Analytics</h2>
        <p>
          We use Google Analytics 4 (GA4) to understand aggregate traffic patterns such as which pages are visited and from which geographic regions. GA4 collects anonymized usage data. It does not receive any of the numbers you enter into our calculators. You can opt out of GA4 tracking using the <a href="https://tools.google.com/dlpage/gaoptout" class="text-[var(--color-accent)]" rel="noopener noreferrer" target="_blank">Google Analytics Opt-out Browser Add-on</a>.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-[var(--color-text)] mb-3">Children's Privacy</h2>
        <p>
          This site is not directed at children under 13. We do not knowingly collect personal information from children under 13.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-[var(--color-text)] mb-3">Changes to This Policy</h2>
        <p>
          We may update this policy occasionally. The "Last updated" date at the top reflects the most recent revision. Continued use of the site after changes constitutes acceptance of the updated policy.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-[var(--color-text)] mb-3">Contact</h2>
        <p>
          Questions about this policy? Email us at <a href="mailto:hello@realcpmcalculator.com" class="text-[var(--color-accent)]">hello@realcpmcalculator.com</a>.
        </p>
      </section>

    </div>
  </main>
  <SiteFooter />
</BaseLayout>
