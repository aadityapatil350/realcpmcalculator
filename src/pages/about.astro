---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const pageUrl = 'https://realcpmcalculator.com/about';
---
<BaseLayout
  title="About Us – RealCPMCalculator.com Ad Math Suite"
  description="Learn about RealCPMCalculator.com, our editorial standards, and the ad-tech math powering our free CPM, CPC, CTR, ROAS, CAC, and CPV media calculators."
  canonical={pageUrl}
>
  <SiteHeader />
  <main class="max-w-3xl mx-auto px-4 sm:px-6 py-10">
    <h1 class="text-3xl font-bold text-[var(--color-text)] mb-2">About RealCPMCalculator</h1>
    <p class="text-[var(--color-text-muted)] mb-8">Independent ad-tech calculators and media planning math built for growth teams, media buyers, and digital agencies.</p>

    <div class="space-y-8 text-[var(--color-text-muted)] leading-relaxed mt-6">

      <section>
        <h2 class="text-xl font-semibold text-[var(--color-text)] mb-3">Why We Built This Platform</h2>
        <p>
          Every paid-media practitioner, growth marketer, and media planner has, at some point, searched for a CPM calculator or ROAS formula only to land on an ad-cluttered page that solves in only one direction, breaks on mobile devices, requires sign-ups, or was designed in 2009.
        </p>
        <p class="mt-3">
          RealCPMCalculator.com was developed to solve that problem. Our mission is to provide clean, fast, beautiful, and mathematically rigorous media calculators that solve bidirectionally, illustrate the underlying mathematical steps, support dark mode, and run entirely in your web browser with 0 kB of server tracking.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-[var(--color-text)] mb-3">Our Core Calculation Suite</h2>
        <p>
          All calculators on RealCPMCalculator.com implement standard industry formulas used by Google Ads, Meta Ads Manager, Amazon Advertising, and programmatic demand-side platforms (DSPs):
        </p>
        <ul class="mt-3 space-y-2 list-disc list-inside">
          <li><strong>CPM (Cost Per Mille):</strong> Solves spend, impressions, or CPM using <code>(Spend ÷ Impressions) × 1,000</code>.</li>
          <li><strong>CPC (Cost Per Click):</strong> Solves spend, clicks, or cost per click via <code>Spend ÷ Clicks</code>.</li>
          <li><strong>CTR (Click-Through Rate):</strong> Measures engagement efficiency via <code>(Clicks ÷ Impressions) × 100%</code>.</li>
          <li><strong>ROAS (Return on Ad Spend):</strong> Solves revenue, ad spend, or ROAS multiplier via <code>Revenue ÷ Spend</code>, with break-even evaluation.</li>
          <li><strong>CAC (Customer Acquisition Cost):</strong> Determines customer onboarding cost and evaluates healthy unit economics against Customer Lifetime Value (LTV).</li>
          <li><strong>CPV (Cost Per View):</strong> Calculates video ad efficiency and required budgets across YouTube TrueView, Meta, and TikTok video campaigns.</li>
        </ul>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-[var(--color-text)] mb-3">Editorial Standards &amp; Benchmark Methodology</h2>
        <p>
          The performance benchmarks and industry averages published on our site are sourced from verified, publicly available research reports and platform data from WordStream, LocaliQ, Statista, Google Ads, Meta for Business, LinkedIn Marketing Solutions, TikTok for Business, and the Interactive Advertising Bureau (IAB).
        </p>
        <p class="mt-3">
          Our engineering and editorial team reviews these benchmarks annually to reflect shifting auction dynamics, privacy changes, and ad platform updates. We do not accept sponsored placements or paid editorial bias in our benchmark tables.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-[var(--color-text)] mb-3">Zero-Data Architecture &amp; Privacy by Design</h2>
        <p>
          We believe financial and campaign metrics belong exclusively to your business. All calculations on RealCPMCalculator.com execute 100% client-side inside your browser's local JavaScript engine. No figures you enter are ever transmitted to an origin server, stored in a database, or shared with analytics providers. When you close the browser tab, your numbers are permanently erased from device memory.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-[var(--color-text)] mb-3">Contact &amp; Feedback</h2>
        <p>
          Have a suggestion for a new media planning calculator or spotted a discrepancy in our industry benchmarks? We welcome feedback from marketing practitioners. Reach us directly at <a href="mailto:hello@realcpmcalculator.com" class="text-[var(--color-accent)] underline">hello@realcpmcalculator.com</a> or visit our <a href="/contact" class="text-[var(--color-accent)] underline">Contact Page</a>.
        </p>
      </section>

    </div>
  </main>
  <SiteFooter />
</BaseLayout>
