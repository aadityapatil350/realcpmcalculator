---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import AdSlot from '../components/AdSlot.astro';
import FAQ from '../components/FAQ.astro';
import RelatedTools from '../components/RelatedTools.astro';

const pageUrl = 'https://realcpmcalculator.com/cac-calculator';

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "CAC Calculator – Customer Acquisition Cost & LTV Ratio",
  "url": pageUrl,
  "applicationCategory": "BusinessApplication",
  "applicationSubCategory": "Marketing & Financial Analytics",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript",
  "description": "Calculate customer acquisition cost (CAC) and LTV:CAC ratio instantly from sales and marketing expenses with industry benchmark analysis.",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "featureList": [
    "Combined sales and marketing spend inputs",
    "Instant CAC calculation with formula readout",
    "Customer lifetime value (LTV) input with automated LTV:CAC ratio evaluation",
    "Interactive multi-currency selector (USD, EUR, GBP, INR, AUD, CAD)",
    "Shareable calculation link generator and clipboard copy",
    "Client-side processing with zero server tracking"
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://realcpmcalculator.com" },
    { "@type": "ListItem", "position": 2, "name": "CAC Calculator", "item": pageUrl }
  ]
};

const faqs = [
  {
    q: "How do you calculate customer acquisition cost?",
    a: "CAC = (Total Sales Spend + Total Marketing Spend) ÷ New Customers Acquired. For example, if your company spent $10,000 on sales and $20,000 on marketing during a quarter and gained 300 new customers, your CAC is ($10,000 + $20,000) ÷ 300 = $100.00. Only count brand-new acquired customers; do not count renewals, upgrades, or returning customers."
  },
  {
    q: "What is a good CAC?",
    a: "A 'good' CAC is entirely relative to your Customer Lifetime Value (LTV) and gross margins. A $500 CAC is unsustainable for an e-commerce store with an average $80 basket, but world-class for an enterprise B2B SaaS platform charging $40,000 annually. As a rule of thumb, healthy business unit economics require an LTV at least 3× your CAC."
  },
  {
    q: "What is a good LTV to CAC ratio?",
    a: "The standard gold benchmark for subscription, SaaS, and recurring revenue businesses is an LTV:CAC ratio of 3:1 or higher. A ratio under 2:1 indicates your acquisition costs are eating up your operating margins. A ratio over 5:1 typically indicates you are underinvesting in marketing and leaving market share on the table to competitors."
  },
  {
    q: "What is the difference between blended CAC and paid CAC?",
    a: "Blended CAC divides total marketing and sales expenses by ALL new customers acquired across both organic and paid channels. Paid CAC divides paid advertising spend solely by new customers acquired directly from paid ad campaigns. Relying exclusively on blended CAC can mask unprofitable paid advertising channels because organic and word-of-mouth growth artificially inflates the customer denominator."
  },
  {
    q: "What expense items should be included in CAC?",
    a: "A true, comprehensive CAC includes: paid media ad spend, marketing agency fees, sales and marketing salaries, sales commissions, creative production expenses, marketing software tools (CRM, email platforms, attribution software), and onboarding collateral. Do not include customer success or account management costs dedicated to retaining existing accounts."
  },
  {
    q: "How can a business lower its customer acquisition cost?",
    a: "To reduce CAC: 1) Improve conversion rates across landing pages and sales funnels; 2) Increase organic traffic through SEO and content marketing; 3) Retarget high-intent website visitors instead of only funding cold prospect acquisition; 4) Launch customer referral and advocacy programs; and 5) Prune non-converting keywords and ad placements in paid ad networks."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};
---
<BaseLayout
  title="CAC Calculator – Customer Acquisition Cost & LTV Ratio"
  description="Free CAC calculator. Calculate customer acquisition cost and LTV:CAC ratio instantly from sales and marketing spend with industry benchmarks."
  canonical={pageUrl}
  schema={[webAppSchema, breadcrumbSchema, faqSchema]}
>
  <SiteHeader current="/cac-calculator" />
  <main class="max-w-3xl mx-auto px-4 sm:px-6 py-10">

    <h1 class="text-3xl sm:text-4xl font-bold text-[var(--color-text)] mb-2">CAC Calculator</h1>
    <p class="text-[var(--color-text-muted)] mb-8">
      Calculate customer acquisition cost from sales and marketing spend. Includes LTV:CAC ratio so you can assess campaign efficiency at a glance.
    </p>

    <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] p-6 shadow-sm">

      <div class="flex items-center gap-3 mb-6">
        <label for="currency" class="text-sm font-medium text-[var(--color-text-muted)] whitespace-nowrap">Currency:</label>
        <select id="currency" class="w-36">
          <option value="USD">USD ($)</option>
          <option value="EUR">EUR (€)</option>
          <option value="GBP">GBP (£)</option>
          <option value="INR">INR (₹)</option>
          <option value="AUD">AUD (A$)</option>
          <option value="CAD">CAD (C$)</option>
        </select>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
        <div>
          <label for="sales-spend" class="block text-sm font-medium text-[var(--color-text)] mb-1">Sales Spend</label>
          <input type="number" id="sales-spend" inputmode="decimal" min="0" step="any" placeholder="e.g. 10000" value="10000" aria-describedby="sales-error" />
          <p id="sales-error" class="mt-1 text-xs text-[var(--color-error)] hidden" role="alert"></p>
        </div>
        <div>
          <label for="marketing-spend" class="block text-sm font-medium text-[var(--color-text)] mb-1">Marketing Spend</label>
          <input type="number" id="marketing-spend" inputmode="decimal" min="0" step="any" placeholder="e.g. 20000" value="20000" aria-describedby="marketing-error" />
          <p id="marketing-error" class="mt-1 text-xs text-[var(--color-error)] hidden" role="alert"></p>
        </div>
        <div>
          <label for="new-customers" class="block text-sm font-medium text-[var(--color-text)] mb-1">New Customers Acquired</label>
          <input type="number" id="new-customers" inputmode="decimal" min="1" step="any" placeholder="e.g. 300" value="300" aria-describedby="customers-error" />
          <p id="customers-error" class="mt-1 text-xs text-[var(--color-error)] hidden" role="alert"></p>
        </div>
        <div>
          <label for="ltv" class="block text-sm font-medium text-[var(--color-text)] mb-1">Customer LTV <span class="text-[var(--color-text-subtle)] font-normal">(optional)</span></label>
          <input type="number" id="ltv" inputmode="decimal" min="0" step="any" placeholder="e.g. 900" aria-describedby="ltv-error" />
          <p id="ltv-error" class="mt-1 text-xs text-[var(--color-error)] hidden" role="alert"></p>
        </div>
      </div>

      <div id="results" class="rounded-lg bg-[var(--color-result-bg)] border border-[var(--color-result-border)] p-5 space-y-3">
        <div class="flex justify-between items-center">
          <span class="text-sm font-medium text-[var(--color-text)]">Customer Acquisition Cost (CAC)</span>
          <span id="result-cac" class="text-2xl font-bold text-[var(--color-accent)]">$100.00</span>
        </div>
        <div class="flex justify-between items-center border-t border-[var(--color-result-border)] pt-3">
          <span class="text-sm text-[var(--color-text-muted)]">Total Spend</span>
          <span id="result-total" class="text-sm font-medium text-[var(--color-text)]">$30,000.00</span>
        </div>
        <div id="ltv-ratio-row" class="hidden justify-between items-center border-t border-[var(--color-result-border)] pt-3 flex">
          <span class="text-sm text-[var(--color-text-muted)]">LTV:CAC Ratio</span>
          <span id="result-ltv-ratio" class="text-sm font-medium text-[var(--color-text)]">—</span>
        </div>
        <div id="ltv-assessment-row" class="hidden border-t border-[var(--color-result-border)] pt-3">
          <p id="result-ltv-assessment" class="text-xs text-[var(--color-text-muted)]"></p>
        </div>
        <div class="border-t border-[var(--color-result-border)] pt-3">
          <p class="text-xs text-[var(--color-text-muted)] font-mono" id="formula-display">CAC = ($10,000 + $20,000) ÷ 300 = $100.00</p>
        </div>
      </div>

      <div class="flex flex-wrap gap-3 mt-4">
        <button id="copy-result" type="button" class="inline-flex items-center gap-2 px-4 py-2 rounded-md bg-[var(--color-bg-subtle)] border border-[var(--color-border)] text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors" style="min-height:44px">Copy Result</button>
        <button id="copy-link" type="button" class="inline-flex items-center gap-2 px-4 py-2 rounded-md bg-[var(--color-bg-subtle)] border border-[var(--color-border)] text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors" style="min-height:44px">Copy link to this calculation</button>
      </div>
    </div>

    <AdSlot size="leaderboard" />

    <article class="mt-8 space-y-8 text-[var(--color-text)] leading-relaxed">

      <section>
        <h2 class="text-2xl font-semibold mb-3">How to Use This Customer Acquisition Cost Calculator</h2>
        <p class="text-[var(--color-text-muted)] leading-relaxed mb-4">
          Customer Acquisition Cost (CAC) is the most critical metric for evaluating the sustainability and scalability of your customer growth engine. This calculator computes your true CAC in real time, breaks down your combined sales and marketing expenditures, and tests your unit economics against your average Customer Lifetime Value (LTV).
        </p>
        <ol class="list-decimal pl-5 space-y-2 text-[var(--color-text-muted)]">
          <li><strong>Input Total Sales Spend:</strong> Enter all costs related to closing new accounts, including sales representative salaries, commissions, demo software licenses, and travel.</li>
          <li><strong>Input Total Marketing Spend:</strong> Enter paid media spend, creative production costs, agency retainers, and marketing automation software subscriptions.</li>
          <li><strong>Enter New Customers Acquired:</strong> Specify only newly converted first-time purchasing customers during the exact corresponding measurement window.</li>
          <li><strong>Add Customer Lifetime Value (Optional):</strong> Enter your estimated average gross margin lifetime value per customer to immediately calculate and evaluate your LTV:CAC health ratio.</li>
        </ol>
      </section>

      <section>
        <h2 class="text-2xl font-semibold mb-3">The CAC Formula &amp; Calculation Methodology</h2>
        <div class="bg-[var(--color-bg-subtle)] border border-[var(--color-border)] rounded-lg p-4 font-mono text-sm mb-4">
          CAC = (Total Sales Spend + Total Marketing Spend) &divide; New Customers Acquired
        </div>
        <p class="text-[var(--color-text-muted)] leading-relaxed">
          <strong>Step-by-Step Practical Calculation:</strong> Suppose an online B2B software vendor spends $15,000 on Google Search Ads, $5,000 on LinkedIn campaigns, and pays $10,000 in sales rep compensation during one quarter. The total customer acquisition expenditure equals $30,000. If those campaigns generated 150 brand-new paying business accounts, the CAC calculation is:
        </p>
        <div class="bg-[var(--color-bg-subtle)] border border-[var(--color-border)] rounded-lg p-3 font-mono text-xs my-3">
          CAC = ($10,000 sales + $20,000 marketing) &divide; 150 accounts = $200.00 per customer
        </div>
        <p class="text-[var(--color-text-muted)] leading-relaxed">
          Accurate CAC measurement requires time-lag awareness. If your average sales cycle is 60 days, marketing dollars deployed in January will bear fruit as new customers in March. Comparing January spend to January closed deals distorts CAC during periods of rapid spend scaling or contraction.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-semibold mb-3">LTV:CAC Ratio &amp; Healthy Unit Economics</h2>
        <p class="text-[var(--color-text-muted)] leading-relaxed mb-3">
          Evaluating CAC in isolation is meaningless without comparing it to Customer Lifetime Value (LTV). A company spending $400 to acquire a customer with an LTV of $300 will quickly deplete its cash reserves. Conversely, a company spending $400 to acquire a customer who generates $2,400 in gross margin over their relationship has built an exceptionally profitable growth engine.
        </p>
        <div class="overflow-x-auto my-4">
          <table class="w-full text-sm border-collapse">
            <thead>
              <tr class="bg-[var(--color-bg-subtle)]">
                <th class="text-left p-3 border border-[var(--color-border)] font-semibold">LTV:CAC Ratio</th>
                <th class="text-left p-3 border border-[var(--color-border)] font-semibold">Economic Status</th>
                <th class="text-left p-3 border border-[var(--color-border)] font-semibold">Strategic Recommendation</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="p-3 border border-[var(--color-border)] font-mono font-medium text-rose-600 dark:text-rose-400">&lt; 1.0x</td>
                <td class="p-3 border border-[var(--color-border)]">Value Destructive</td>
                <td class="p-3 border border-[var(--color-border)]">You lose cash on every deal. Immediately halt paid marketing and overhaul onboarding, pricing, or retention.</td>
              </tr>
              <tr class="bg-[var(--color-bg-subtle)]">
                <td class="p-3 border border-[var(--color-border)] font-mono font-medium text-amber-600 dark:text-amber-400">1.0x – 2.5x</td>
                <td class="p-3 border border-[var(--color-border)]">Marginally Viable</td>
                <td class="p-3 border border-[var(--color-border)]">Operating overhead and churn leave virtually zero net profit. Focus on improving customer retention and upselling.</td>
              </tr>
              <tr>
                <td class="p-3 border border-[var(--color-border)] font-mono font-medium text-emerald-600 dark:text-emerald-400">3.0x – 4.0x</td>
                <td class="p-3 border border-[var(--color-border)]">Target Sweet Spot</td>
                <td class="p-3 border border-[var(--color-border)]">Healthy, sustainable growth. Cash flow can be aggressively reinvested into acquiring more market share.</td>
              </tr>
              <tr class="bg-[var(--color-bg-subtle)]">
                <td class="p-3 border border-[var(--color-border)] font-mono font-medium text-blue-600 dark:text-blue-400">&gt; 5.0x</td>
                <td class="p-3 border border-[var(--color-border)]">Underinvesting</td>
                <td class="p-3 border border-[var(--color-border)]">You are leaving revenue on the table. You can afford to bid more aggressively on competitive search terms to scale faster.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-semibold mb-3">Blended CAC vs Paid CAC: Why Both Matter</h2>
        <p class="text-[var(--color-text-muted)] leading-relaxed mb-3">
          Growth marketers must distinguish between <strong>Blended CAC</strong> and <strong>Paid CAC</strong>:
        </p>
        <ul class="list-disc pl-5 space-y-2 text-[var(--color-text-muted)]">
          <li><strong>Blended CAC:</strong> Divides all acquisition spend by <em>all</em> new customers, including those who arrived via word-of-mouth, direct navigation, brand PR, or organic search. While Blended CAC reflects your company's macro efficiency, it can create a dangerous illusion if organic growth masks failing paid ad channels.</li>
          <li><strong>Paid CAC:</strong> Divides paid ad spend exclusively by customers attributed directly to paid campaigns. If your paid CAC is $450 on a product with a $350 LTV, scaling your ad budget will accelerate cash burn, even if your blended CAC looks acceptable due to viral organic loops.</li>
        </ul>
      </section>

      <section>
        <h2 class="text-2xl font-semibold mb-3">Industry CAC Benchmarks (2024–2026)</h2>
        <p class="text-[var(--color-text-muted)] leading-relaxed mb-3">
          Customer acquisition costs vary widely across business models, competitive dynamics, and sales cycles. Typical median ranges include:
        </p>
        <div class="overflow-x-auto">
          <table class="w-full text-sm border-collapse">
            <thead>
              <tr class="bg-[var(--color-bg-subtle)]">
                <th class="text-left p-3 border border-[var(--color-border)] font-semibold">Industry Vertical</th>
                <th class="text-right p-3 border border-[var(--color-border)] font-semibold">Typical CAC Range</th>
                <th class="text-right p-3 border border-[var(--color-border)] font-semibold">Target Payback Period</th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="p-3 border border-[var(--color-border)]">B2B SaaS (SMB)</td><td class="text-right p-3 border border-[var(--color-border)]">$150–$600</td><td class="text-right p-3 border border-[var(--color-border)]">&lt; 12 months</td></tr>
              <tr class="bg-[var(--color-bg-subtle)]"><td class="p-3 border border-[var(--color-border)]">B2B SaaS (Enterprise)</td><td class="text-right p-3 border border-[var(--color-border)]">$5,000–$60,000+</td><td class="text-right p-3 border border-[var(--color-border)]">12–18 months</td></tr>
              <tr><td class="p-3 border border-[var(--color-border)]">Direct-to-Consumer (DTC) E-commerce</td><td class="text-right p-3 border border-[var(--color-border)]">$20–$110</td><td class="text-right p-3 border border-[var(--color-border)]">First purchase / &lt; 3 mo</td></tr>
              <tr class="bg-[var(--color-bg-subtle)]"><td class="p-3 border border-[var(--color-border)]">Financial Services &amp; FinTech</td><td class="text-right p-3 border border-[var(--color-border)]">$250–$1,400</td><td class="text-right p-3 border border-[var(--color-border)]">12–24 months</td></tr>
              <tr><td class="p-3 border border-[var(--color-border)]">Healthcare &amp; MedTech</td><td class="text-right p-3 border border-[var(--color-border)]">$300–$900</td><td class="text-right p-3 border border-[var(--color-border)]">6–12 months</td></tr>
              <tr class="bg-[var(--color-bg-subtle)]"><td class="p-3 border border-[var(--color-border)]">Commercial Real Estate</td><td class="text-right p-3 border border-[var(--color-border)]">$750–$2,500</td><td class="text-right p-3 border border-[var(--color-border)]">On transaction close</td></tr>
            </tbody>
          </table>
        </div>
        <p class="text-xs text-[var(--color-text-subtle)] mt-2">Sources: ProfitWell SaaS benchmarks; Shopify E-commerce Metrics Report; FirstPageSage CAC index (2024). Updated August 2026.</p>
      </section>

      <section>
        <h2 class="text-2xl font-semibold mb-3">Actionable Strategies to Lower CAC</h2>
        <ul class="space-y-3 text-[var(--color-text-muted)]">
          <li><strong>Optimize On-Page Conversion Rates (CRO):</strong> Doubling your landing page conversion rate from 2% to 4% immediately cuts your paid acquisition cost in half without altering ad bids.</li>
          <li><strong>Tighten Ad Targeting &amp; Add Negative Keywords:</strong> Review Google Ads search terms reports weekly. Eliminating irrelevant non-converting search queries prevents budget drain.</li>
          <li><strong>Shorten Sales Cycles:</strong> Lengthy sales pipelines inflate sales rep overhead. Streamline product demos, offer self-serve trials, and provide clear upfront pricing.</li>
          <li><strong>Incentivize Customer Referrals:</strong> Referred customers convert up to 30% higher and carry near-zero acquisition costs, drastically reducing blended CAC across your portfolio.</li>
        </ul>
      </section>

    </article>

    <AdSlot size="rectangle" />
    <FAQ items={faqs} />
    <RelatedTools current="/cac-calculator" />
  </main>
  <SiteFooter />
</BaseLayout>

<script>
(function() {
  const currencies = {
    USD: { locale: 'en-US', currency: 'USD' }, EUR: { locale: 'de-DE', currency: 'EUR' },
    GBP: { locale: 'en-GB', currency: 'GBP' }, INR: { locale: 'en-IN', currency: 'INR' },
    AUD: { locale: 'en-AU', currency: 'AUD' }, CAD: { locale: 'en-CA', currency: 'CAD' },
  };
  function fmt(v, k, d = 2) { const c = currencies[k]||currencies.USD; return new Intl.NumberFormat(c.locale,{style:'currency',currency:c.currency,minimumFractionDigits:d,maximumFractionDigits:d}).format(v); }
  function fmtN(v, d = 0) { return new Intl.NumberFormat('en-US',{minimumFractionDigits:d,maximumFractionDigits:d}).format(v); }

  const salesEl = document.getElementById('sales-spend');
  const mktEl = document.getElementById('marketing-spend');
  const custEl = document.getElementById('new-customers');
  const ltvEl = document.getElementById('ltv');
  const currEl = document.getElementById('currency');

  const params = new URLSearchParams(window.location.search);
  if (params.has('sales')) salesEl.value = params.get('sales');
  if (params.has('marketing')) mktEl.value = params.get('marketing');
  if (params.has('customers')) custEl.value = params.get('customers');
  if (params.has('ltv')) ltvEl.value = params.get('ltv');
  if (params.has('currency') && currencies[params.get('currency')]) currEl.value = params.get('currency');

  function clearErr(el, errEl) { el.classList.remove('error'); errEl.classList.add('hidden'); errEl.textContent = ''; }
  function showErr(el, errEl, msg) { el.classList.add('error'); errEl.textContent = msg; errEl.classList.remove('hidden'); }
  function getVal(el) { const v = el.value.trim(); if (v === '') return null; const n = parseFloat(v); return isNaN(n) ? NaN : n; }

  function recalc() {
    const curr = currEl.value;
    clearErr(salesEl, document.getElementById('sales-error'));
    clearErr(mktEl, document.getElementById('marketing-error'));
    clearErr(custEl, document.getElementById('customers-error'));
    clearErr(ltvEl, document.getElementById('ltv-error'));

    const s = getVal(salesEl); const m = getVal(mktEl); const c = getVal(custEl); const l = getVal(ltvEl);

    let valid = true;
    if (s !== null) { if (isNaN(s)||s<0) { showErr(salesEl, document.getElementById('sales-error'), 'Must be a non-negative number.'); valid = false; } }
    if (m !== null) { if (isNaN(m)||m<0) { showErr(mktEl, document.getElementById('marketing-error'), 'Must be a non-negative number.'); valid = false; } }
    if (c !== null) { if (isNaN(c)||c<=0) { showErr(custEl, document.getElementById('customers-error'), 'Must be greater than zero.'); valid = false; } }
    if (l !== null) { if (isNaN(l)||l<0) { showErr(ltvEl, document.getElementById('ltv-error'), 'Must be a non-negative number.'); valid = false; } }
    if (!valid) return;

    if (s === null || m === null || c === null) {
      document.getElementById('result-cac').textContent = '—';
      document.getElementById('result-total').textContent = '—';
      document.getElementById('formula-display').textContent = '';
      return;
    }

    const totalSpend = s + m;
    const cac = totalSpend / c;
    document.getElementById('result-cac').textContent = fmt(cac, curr);
    document.getElementById('result-total').textContent = fmt(totalSpend, curr);
    document.getElementById('formula-display').textContent = `CAC = (${fmt(s, curr, 0)} + ${fmt(m, curr, 0)}) ÷ ${fmtN(c)} = ${fmt(cac, curr)}`;

    const ltvRatioRow = document.getElementById('ltv-ratio-row');
    const ltvAssessRow = document.getElementById('ltv-assessment-row');
    const ltvAssessEl = document.getElementById('result-ltv-assessment');

    if (l !== null && l > 0 && cac > 0) {
      const ratio = l / cac;
      document.getElementById('result-ltv-ratio').textContent = `${ratio.toFixed(2)}x`;
      ltvRatioRow.classList.remove('hidden');

      let assess = '';
      if (ratio < 1) assess = '⚠️ Unprofitable: LTV is less than CAC. You lose money on every acquired customer.';
      else if (ratio < 3) assess = '⚠️ Caution: LTV:CAC is below the recommended 3:1 ratio. Operating margins may be compressed.';
      else if (ratio <= 5) assess = '✅ Healthy: LTV:CAC is within the recommended 3:1–5:1 benchmark range.';
      else assess = '🚀 High efficiency: LTV:CAC exceeds 5:1. You may have room to invest more aggressively in growth.';

      ltvAssessEl.textContent = assess;
      ltvAssessRow.classList.remove('hidden');
    } else {
      ltvRatioRow.classList.add('hidden');
      ltvAssessRow.classList.add('hidden');
    }
  }

  [salesEl, mktEl, custEl, ltvEl].forEach(el => el.addEventListener('input', recalc));
  currEl.addEventListener('change', recalc);
  recalc();

  document.getElementById('copy-result').addEventListener('click', () => {
    const cac = document.getElementById('result-cac').textContent;
    navigator.clipboard.writeText(`Customer Acquisition Cost: ${cac}`).then(() => {
      const btn = document.getElementById('copy-result');
      btn.textContent = 'Copied!';
      setTimeout(() => { btn.textContent = 'Copy Result'; }, 2000);
    });
  });

  document.getElementById('copy-link').addEventListener('click', () => {
    const url = new URL(window.location.href);
    if (salesEl.value) url.searchParams.set('sales', salesEl.value);
    if (mktEl.value) url.searchParams.set('marketing', mktEl.value);
    if (custEl.value) url.searchParams.set('customers', custEl.value);
    if (ltvEl.value) url.searchParams.set('ltv', ltvEl.value);
    url.searchParams.set('currency', currEl.value);
    navigator.clipboard.writeText(url.toString()).then(() => {
      const btn = document.getElementById('copy-link');
      btn.textContent = 'Link Copied!';
      setTimeout(() => { btn.textContent = 'Copy link to this calculation'; }, 2000);
    });
  });
})();
</script>
